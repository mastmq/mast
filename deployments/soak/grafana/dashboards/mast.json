      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(mast_durable_publish_failures_total{namespace=\"$namespace\", pod=~\"$pod\"}[$__range]))",
          "instant": false,
          "range": true
        }
      ]
    },
    {
