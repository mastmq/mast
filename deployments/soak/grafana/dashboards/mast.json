          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(mast_messages_in_total{namespace=\"$namespace\", pod=~\"$pod\", tenant=~\"$tenant\"}[$__rate_interval]))",
          "instant": false,
          "range": true
